# Channels: public link, private invite link, numeric link, username, or title
SOURCE=https://t.me/source_channel
DESTINATION=https://t.me/destination_channel

# ALL, WORDS, PHOTO, DOCUMENT, DOCUMENT_FORMAT, AUDIO, VIDEO, or VOICE
FORWARD_MODE=ALL

# Comma-separated values (used by WORDS and DOCUMENT_FORMAT)
WORDS=sport,internet,meme
FILE_FORMATS=pdf,zip,rar

# Observer settings
POLL_INTERVAL=5

# Pyrogram session file name (without .session)
SESSION_NAME=account

# Resume ledger for verified REUPLOAD items
CLONE_STATE_FILE=.clone-state.sqlite3

# Parent directory for temporary downloads and upload verification files
TEMP_DOWNLOAD_DIR=.clone-temp

# Optional 7-Zip executable path for documents above Telegram's upload limit
# SEVEN_ZIP_PATH=C:/Program Files/7-Zip/7z.exe
